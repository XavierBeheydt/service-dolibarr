# Copy to .env and fill in (`just env` does the copy). .env is git-ignored.
# The defaults below are for local testing; see README.md for production.

# Host name Dolibarr is served on, through Traefik.
# Locally, *.docker.localhost resolves to 127.0.0.1 without any DNS setup.
DOLIBARR_HOST=dolibarr.docker.localhost

# Image tags. Dolibarr is pinned to a major version: going to the next one
# migrates the database (see "Upgrade" in README.md).
DOLIBARR_VERSION=24
MARIADB_VERSION=12.3

# Time zone of PHP and MariaDB
TZ=Europe/Paris

# The passwords and keys are not set here: they are Docker secrets, one file
# per value in secrets/, generated by `just secrets` (see README.md).

# Database, created at the first start
DB_NAME=dolibarr
DB_USER=dolibarr

# First admin account, created at the first start only: changing it later has
# no effect. Its password is in secrets/doli_admin_password.
DOLI_ADMIN_LOGIN=admin

# Company and modules set up at the first start only.
# Modules are comma separated, e.g. Cron,Societe,Propale,Facture,Banque.
# Keep Cron: the cron key is only stored when the module is enabled at install.
DOLI_COMPANY_NAME="My Company"
DOLI_COMPANY_COUNTRYCODE=FR
DOLI_ENABLE_MODULES=Cron

# Maximum size of an uploaded file, and of a whole form post
PHP_INI_UPLOAD_MAX_FILESIZE=20M
PHP_INI_POST_MAX_SIZE=22M
