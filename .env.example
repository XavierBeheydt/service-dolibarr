# Copy to .env (`just env` does the copy). .env is git-ignored.
# The defaults below are for local testing; see README.md for production.

# Dolibarr is served on dolibarr.<DOMAIN>, through Traefik. Use the same DOMAIN
# as services/traefik. Locally, *.docker.localhost resolves to 127.0.0.1 without
# any DNS setup.
DOMAIN=docker.localhost

# Image tags. Dolibarr is pinned to a major version: going to the next one
# migrates the database.
DOLIBARR_VERSION=24
MARIADB_VERSION=lts

# Time zone of PHP and MariaDB
TZ=Europe/Paris

# Database name, created at the first start
DB_NAME=dolibarr

# First admin account, created at the first start only: changing it later has
# no effect. The database user and every password are Docker secrets, one file
# per value in secrets/, generated by `just secrets` (see README.md).
DOLI_ADMIN_LOGIN=admin
